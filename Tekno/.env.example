# .env.example - copy to .env and edit values as needed

# ASP.NET environment
ASPNETCORE_ENVIRONMENT=Development

# Database (the app also supports overriding via DB_CONNECTION_STRING)
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=tekno;Username=postgres;Password=postgres
# alternatively set the nested config key:
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=tekno;Username=postgres;Password=postgres

# JWT
JWT_SECRET_KEY=ThisIsAVeryMysteriousKeyProtectItPlease
JWT_ISSUER=TeknoApi
JWT_AUDIENCE=TeknoUsers
JWT_EXPIRY_MINUTES=60

# Redis
Redis__ConnectionString=localhost:6379

# Elasticsearch
ElasticSearch__Uri=http://localhost:9200
ElasticSearch__IndexName=products

# Cloudinary (optional)
Cloudinary__Url=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# VNPay (sandbox)
VNPay__TmnCode=code
VNPay__HashSecret=hash
VNPay__PaymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPay__ReturnUrl=https://localhost:5000/api/payment/vnpay/return
VNPay__IpnUrl=https://localhost:5000/api/payment/vnpay/ipn
VNPay__ApiUrl=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Optional: Training/recommendation service base URL
TRAINING_API_URL=http://trainning_api:8000

# Notes:
# - Use double-underscore `__` when providing nested configuration via environment variables
#   (e.g. `VNPay__TmnCode` maps to `VNPay:TmnCode` in appsettings).
# - Keep secrets (JWT secret, VNPay hash) safe in production and do NOT commit real secrets.
# ===============================================
# Tekno API - Environment Variables Template
# ===============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to Git (it's in .gitignore)
#
# ===============================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tekno
DB_CONNECTION_STRING=Host=db;Database=tekno;Username=postgres;Password=postgres

# Redis
REDIS_CONNECTION_STRING=redis:6379
REDIS_INSTANCE_NAME=Tekno_

# Elasticsearch
ELASTICSEARCH_URI=http://elasticsearch:9200
ELASTICSEARCH_INDEX_NAME=products

# Cloudinary - Get from https://cloudinary.com/console
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME
# OR separate values:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# JWT Settings
JWT_SECRET_KEY=ThisIsAVeryMysteriousKeyProtectItPlease
JWT_EXPIRY_MINUTES=60

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
