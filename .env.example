# ===============================================
# Tekno API - Environment Variables Template
# ===============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to Git (it's in .gitignore)
#
# ===============================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tekno
DB_CONNECTION_STRING=Host=db;Database=tekno;Username=postgres;Password=postgres

# Redis
REDIS_CONNECTION_STRING=redis:6379
REDIS_INSTANCE_NAME=Tekno_

# Elasticsearch
ELASTICSEARCH_URI=http://elasticsearch:9200
ELASTICSEARCH_INDEX_NAME=products

# Cloudinary - Get from https://cloudinary.com/console
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME
# OR separate values:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# JWT Settings
JWT_SECRET_KEY=ThisIsAVeryMysteriousKeyProtectItPlease
JWT_EXPIRY_MINUTES=60

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
